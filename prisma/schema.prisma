// Ashish.sbs Platform — Database Schema
// Content-first architecture: every public page renders one or more of these
// objects. No production content is hardcoded (PRD SYS-003).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum VentureStatus {
  RESEARCH
  ACTIVE
  PAUSED
  SUNSET
}

// What kind of work a project is. The site started out digital-only; these keep
// furniture, teaching and the rest as first-class work rather than tagged
// exceptions.
enum Discipline {
  DIGITAL
  FURNITURE
  TEACHING
  BUSINESS
  PERSONAL
  OTHER
}

// How a project actually ended up. FAILED is deliberately a first-class value —
// the record is not meant to only hold the things that worked.
enum ProjectOutcome {
  SHIPPED
  RUNNING
  PAUSED
  FAILED
}

enum Role {
  FOUNDER
  ADMINISTRATOR
  EDITOR
  CONTRIBUTOR
  VIEWER
  GUEST
}

enum ContactReason {
  COLLABORATION
  CONSULTING
  SPEAKING
  PARTNERSHIP
  GENERAL_INQUIRY
  MEDIA
}

enum FounderStage {
  IDEA_ONLY
  PRE_LAUNCH
  REGISTERED
  GENERATING_REVENUE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// ---------------------------------------------------------------------------
// Auth / CMS users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authoredVentures   Venture[]
  authoredProjects   Project[]
  authoredLabNotes   LabNote[]
  authoredPrinciples Principle[]
  authoredResources  Resource[]
  authoredArticles   Article[]
  authoredReviews    MonthlyReview[]
  authoredInsights   Insight[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Core content objects (Volume I Ch.6, Personal OS Part VI)
// ---------------------------------------------------------------------------

model Venture {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  logoUrl     String?
  status      VentureStatus @default(RESEARCH)
  industry    String?
  summary     String
  problem     String?
  solution    String?
  story       String?
  currentStage String?
  websiteUrl  String?
  repoUrl     String?
  featured    Boolean       @default(false)
  contentStatus ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  authorId String?
  author   User?  @relation(fields: [authorId], references: [id])

  timelineEvents TimelineEvent[]
  lessons        Lesson[]
  projects       Project[]
  externalLinks  ExternalLink[]
  media          Media[]
  tags           TagOnVenture[]
  crew           PersonOnVenture[]

  @@index([status, contentStatus])
  @@map("ventures")
}

model Project {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  summary      String
  background   String?
  objectives   String?
  process      String?
  deliverables String?
  outcome      String?
  industry     String?
  technology   String?
  year         Int?
  discipline   Discipline    @default(DIGITAL)
  outcomeStatus ProjectOutcome?
  imageUrl     String?
  featured     Boolean       @default(false)
  contentStatus ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId String?
  author   User?  @relation(fields: [authorId], references: [id])

  ventureId String?
  venture   Venture? @relation(fields: [ventureId], references: [id])

  lessons       Lesson[]
  relatedPrinciples ProjectPrinciple[]
  relatedResources  ProjectResource[]
  media         Media[]
  tags          TagOnProject[]
  crew          PersonOnProject[]

  @@index([ventureId])
  @@index([discipline, contentStatus])
  @@map("projects")
}

model LabNote {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  category     String?
  pinned       Boolean       @default(false)
  body         String
  contentStatus ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId String?
  author   User?  @relation(fields: [authorId], references: [id])

  tags TagOnLabNote[]

  @@map("lab_notes")
}

model Principle {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  statement    String
  explanation  String?
  examples     String?
  contentStatus ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId String?
  author   User?  @relation(fields: [authorId], references: [id])

  projects ProjectPrinciple[]

  @@map("principles")
}

model Resource {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  category     String?
  format       String?
  difficulty   String?
  description  String?
  downloadUrl  String?
  contentStatus ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId String?
  author   User?  @relation(fields: [authorId], references: [id])

  projects ProjectResource[]

  @@map("resources")
}

model Service {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  problem      String?
  idealClient  String?
  approach     String?
  deliverables String?
  timeline     String?
  faq          Json?
  contentStatus ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("services")
}

model CareerEntry {
  id           String   @id @default(cuid())
  project      String
  organisation String
  role         String
  startDate    DateTime
  endDate      DateTime?
  overview     String
  publicOutcome String?
  lessons      String?
  links        Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("career_entries")
}

model MonthlyReview {
  id           String        @id @default(cuid())
  slug         String        @unique
  month        DateTime
  whatIBuilt   String?
  whatILearned String?
  problems     String?
  failures     String?
  reading      String?
  nextMonth    String?
  contentStatus ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId String?
  author   User?  @relation(fields: [authorId], references: [id])

  @@map("monthly_reviews")
}

model Article {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  summary      String?
  body         String
  readingTime  Int?
  contentStatus ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId String?
  author   User?  @relation(fields: [authorId], references: [id])

  tags TagOnArticle[]

  @@map("articles")
}

model Insight {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  guestName    String?
  videoUrl     String?
  summary      String
  body         String?
  contentStatus ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId String?
  author   User?  @relation(fields: [authorId], references: [id])

  @@map("insights")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  startedAt   DateTime?
  finishedAt  DateTime?
  summary     String?
  lessons     String?
  quotes      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("books")
}

// ---------------------------------------------------------------------------
// Credentials
// ---------------------------------------------------------------------------

// A certification or course credential. Rendered on /about under "Skills".
// `verifyUrl` is what makes an entry checkable rather than a claim — prefer the
// issuer's own verification page over a self-hosted copy of the certificate.
model Certification {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  issuer        String
  issuedAt      DateTime?
  expiresAt     DateTime?
  credentialId  String?
  verifyUrl     String?
  skills        String?       // comma-separated, shown as tags
  contentStatus ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([contentStatus])
  @@map("certifications")
}

// ---------------------------------------------------------------------------
// Crew — the people behind the work
// ---------------------------------------------------------------------------

// A real, named person who helped with something here. Everything is optional
// except the name: a person can be credited long before there's a photo or a
// story written up. DRAFT by default, like every other content model — nobody
// appears publicly until their entry has been read and published deliberately.
model Person {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  alias         String?       // "The Millimetre" — the heist-crew handle
  role          String?       // what they actually do: carpenter, professor, co-founder
  quirk         String?       // the one detail that makes them them
  howWeMet      String?
  whatTheyDid   String?       // the credit, in plain terms
  photoUrl      String?
  links         Json?         // {label, url}[]
  featured      Boolean       @default(false)
  contentStatus ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  projects PersonOnProject[]
  ventures PersonOnVenture[]

  @@index([contentStatus])
  @@map("people")
}

model PersonOnProject {
  personId     String
  projectId    String
  contribution String? // "Built every joint that mattered."

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([personId, projectId])
  @@map("people_on_projects")
}

model PersonOnVenture {
  personId     String
  ventureId    String
  contribution String?

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  venture Venture @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@id([personId, ventureId])
  @@map("people_on_ventures")
}

// ---------------------------------------------------------------------------
// Supporting / relational entities
// ---------------------------------------------------------------------------

model TimelineEvent {
  id          String   @id @default(cuid())
  date        DateTime
  title       String
  description String?

  ventureId String?
  venture   Venture? @relation(fields: [ventureId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("timeline_events")
}

model Lesson {
  id   String @id @default(cuid())
  text String

  ventureId String?
  venture   Venture? @relation(fields: [ventureId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  @@map("lessons")
}

model ExternalLink {
  id    String @id @default(cuid())
  label String
  url   String

  ventureId String?
  venture   Venture? @relation(fields: [ventureId], references: [id])

  @@map("external_links")
}

model Media {
  id       String  @id @default(cuid())
  url      String
  alt      String?
  caption  String?

  ventureId String?
  venture   Venture? @relation(fields: [ventureId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())

  @@map("media")
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  ventures TagOnVenture[]
  projects TagOnProject[]
  labNotes TagOnLabNote[]
  articles TagOnArticle[]

  @@map("tags")
}

// Join tables (explicit, per "no implicit relations" engineering convention)

model TagOnVenture {
  ventureId String
  tagId     String

  venture Venture @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ventureId, tagId])
  @@map("tags_on_ventures")
}

model TagOnProject {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("tags_on_projects")
}

model TagOnLabNote {
  labNoteId String
  tagId     String

  labNote LabNote @relation(fields: [labNoteId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([labNoteId, tagId])
  @@map("tags_on_lab_notes")
}

model TagOnArticle {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("tags_on_articles")
}

model ProjectPrinciple {
  projectId   String
  principleId String

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  principle Principle @relation(fields: [principleId], references: [id], onDelete: Cascade)

  @@id([projectId, principleId])
  @@map("project_principles")
}

model ProjectResource {
  projectId  String
  resourceId String

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([projectId, resourceId])
  @@map("project_resources")
}

// ---------------------------------------------------------------------------
// Contact
// ---------------------------------------------------------------------------

model ContactSubmission {
  id        String        @id @default(cuid())
  name      String
  email     String
  reason    ContactReason
  message   String
  company   String?
  website   String?
  phone     String?
  createdAt DateTime      @default(now())

  @@map("contact_submissions")
}

model IdeaSubmission {
  id               String   @id @default(cuid())
  name             String
  businessIdea     String
  targetCustomer   String
  problem          String
  biggestChallenge String
  createdAt        DateTime @default(now())

  @@map("idea_submissions")
}

// ---------------------------------------------------------------------------
// Realty subdomain (realty.ashish.sbs)
// ---------------------------------------------------------------------------

model RealtyListing {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  subtitle       String?
  location       String
  priceLabel     String
  negotiable     Boolean  @default(true)
  status         String   @default("ACTIVE")
  summary        String
  specifications Json     // {label, value, valueSmall?, highlight?, description}[]
  permittedUses  Json     // {title, description}[]
  locationPoints Json     // {title, description}[]
  whyNow         Json     // {eyebrow, title, description}[]
  stats          Json     // {value, label}[]
  pillars        Json     // {roman, title, description}[]
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inquiries RealtyInquiry[]

  @@map("realty_listings")
}

model RealtyInquiry {
  id        String         @id @default(cuid())
  listingId String?
  listing   RealtyListing? @relation(fields: [listingId], references: [id])
  name      String
  company   String?
  phone     String
  email     String
  city      String?
  budget    String?
  purpose   String?
  message   String?
  confirmed Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@map("realty_inquiries")
}

model SmallBizWaitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("smallbiz_waitlist")
}

model StrategyCallBooking {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String?
  question      String
  triedSoFar    String
  stage         FounderStage
  amount        Int // in paise (₹1,499 = 149900)
  paymentStatus PaymentStatus @default(PENDING)
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("strategy_call_bookings")
}
